rules_version = '2';

// ==========================================
// KraiPRO STOR - Peraturan Keselamatan Firestore
//
// Peranan:
//   SuperAdmin : pkpkk@moh.gov.my (ditetapkan di sini)
//   Pelulus    : dokumen kraipro_users/{email} dengan role == 'pelulus'
//   Pegawai Stor : role == 'penjaga_daerah' (seperti pelulus, tetapi tidak boleh meluluskan permohonan)
//   Pemohon    : dokumen kraipro_users/{email} dengan role == 'pemohon'
// Semua pengguna mesti log masuk (Firebase Auth) dan telah mengesahkan e-mel.
// Apa-apa laluan yang tidak disenaraikan di bawah adalah DITOLAK.
// ==========================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isSuper() {
      return signedIn() && myEmail() == 'pkpkk@moh.gov.my';
    }
    function profilePath() {
      return /databases/$(database)/documents/kraipro_users/$(myEmail());
    }
    function isListed() {
      return signedIn() && exists(profilePath());
    }
    function isMember() {
      return isSuper() || isListed();
    }
    // Kakitangan stor daerah: Pelulus & Pegawai Stor (urus stok, LPO, pindahan, dsb.)
    function isStaff() {
      return isSuper() || (isListed() && get(profilePath()).data.role in ['pelulus', 'penjaga_daerah']);
    }
    // Hanya SuperAdmin & Pegawai Pelulus boleh meluluskan / menolak permohonan stok
    function isPelulus() {
      return isSuper() || (isListed() && get(profilePath()).data.role == 'pelulus');
    }
    // Penjaga stor klinik: ditanda oleh SuperAdmin (penjagaStor == true) dengan Unit/Klinik dalam profil
    function myUnit() {
      return get(profilePath()).data.get('unit', '');
    }
    function isPenjaga() {
      return isListed() && get(profilePath()).data.get('penjagaStor', false) == true && myUnit() != '';
    }
    function isPenjagaOf(unit) {
      return isPenjaga() && myUnit() == unit;
    }

    // Stok induk, pembekal & LPO (satu dokumen)
    match /kraipro_store/live_inventory_state {
      allow read: if isMember();
      // lpoList lama (sebelum LPO dipindahkan ke koleksi sendiri) tidak boleh ditambah/diubah lagi;
      // hanya boleh kekal sama atau dibuang. Ini menghalang tab lama menulis semula senarai LPO.
      allow create, update: if isStaff()
        && request.resource.data.items is list
        && (!('lpoList' in request.resource.data)
            || (resource != null && 'lpoList' in resource.data
                && request.resource.data.lpoList == resource.data.lpoList));
      allow delete: if false;
    }

    // Gambar item (satu dokumen setiap item; gambar JPEG dimampatkan dalam pelayar, had ~200 KB)
    match /kraipro_item_images/{itemId} {
      allow read: if isMember();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['data', 'v', 'dikemaskiniPada', 'dikemaskiniOleh'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 200000
        && request.resource.data.data.matches('^data:image/(jpeg|webp|png);base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.v is int;
      allow delete: if isStaff();
    }

    // Pesanan LPO (satu dokumen setiap LPO) - pelulus & SuperAdmin sahaja
    match /kraipro_lpo/{lpoId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.no is string
        && request.resource.data.items is list;
      allow delete: if isSuper();
    }

    // Senarai pengguna berdaftar (diurus oleh SuperAdmin sahaja)
    match /kraipro_users/{email} {
      // Pengguna boleh semak dokumen sendiri walaupun belum didaftarkan (untuk mesej "belum berdaftar")
      allow read: if isMember() || (signedIn() && email == myEmail());
      allow create, update: if isSuper()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.role in ['pelulus', 'penjaga_daerah', 'pemohon'];
      allow delete: if isSuper();
    }

    // Senarai e-mel dibenarkan (tanpa maklumat peribadi). Boleh disemak SEBELUM log masuk,
    // supaya hanya e-mel yang didaftarkan SuperAdmin boleh menetapkan kata laluan.
    match /kraipro_allowlist/{email} {
      allow get: if true;
      allow list: if isSuper();
      allow create, update: if isSuper()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['aktif'])
        && request.resource.data.aktif == true;
      allow delete: if isSuper();
    }

    // Permohonan akses daripada pengguna yang belum didaftarkan (satu dokumen setiap e-mel).
    // Pemohon hanya boleh menulis permohonan untuk e-mel sendiri (akaun Google yang disahkan).
    function validAccessText(field) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= 120;
    }
    match /kraipro_access_requests/{email} {
      allow get: if isSuper() || (signedIn() && email == myEmail());
      allow list: if isSuper();
      allow create, update: if signedIn()
        && email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'nama', 'jawatan', 'gred', 'unit', 'status', 'createdAt', 'dikemaskiniPada'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'Pending'
        && validAccessText('nama') && request.resource.data.nama.size() > 0
        && validAccessText('jawatan') && validAccessText('gred') && validAccessText('unit');
      allow delete: if isSuper();
    }

    // Permohonan stok (satu dokumen setiap permohonan)
    match /kraipro_requests/{reqId} {
      allow read: if isStaff()
        || (isMember() && (resource == null || resource.data.ownerEmail == myEmail()))
        || (resource != null && isPenjagaOf(resource.data.unit));

      // SuperAdmin juga boleh mencipta (untuk migrasi data lama)
      allow create: if isSuper()
        || (isMember()
            && request.resource.data.ownerEmail == myEmail()
            && request.resource.data.id == reqId
            && reqId.matches('BPSI-[0-9]{4}-[0-9]{3,6}')
            && request.resource.data.status == 'Pending'
            && request.resource.data.items is list
            && request.resource.data.items.size() > 0
            && request.resource.data.items.size() <= 100);

      // Pelulus/SuperAdmin boleh proses (lulus/tolak/batal); Pegawai Stor tidak boleh meluluskan.
      // Pemohon hanya boleh batalkan permohonan sendiri yang masih Pending
      allow update: if isPelulus()
        || (isMember()
            && resource.data.ownerEmail == myEmail()
            && resource.data.status == 'Pending'
            && request.resource.data.status == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'items', 'tarikhBatal']))
        // Penjaga stor klinik mengesahkan penerimaan stok yang diluluskan untuk kliniknya
        || (resource.data.status == 'Selesai'
            && isPenjagaOf(resource.data.unit)
            && resource.data.get('terimaKlinik', '') == 'Menunggu'
            && request.resource.data.terimaKlinik == 'Diterima'
            && request.resource.data.terimaKlinikOleh == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['terimaKlinik', 'terimaKlinikPada', 'terimaKlinikOleh', 'terimaKlinikNama', 'terimaKlinikQty']));

      allow delete: if isSuper();
    }

    // Stor klinik (satu dokumen setiap klinik): baki stok di klinik
    match /kraipro_klinik/{klinikId} {
      // Pelulus: semua klinik. Penjaga & staf klinik: klinik sendiri sahaja (staf biasa baca sahaja,
      // untuk melihat baki & penggunaan klinik semasa membuat permohonan)
      allow read: if isStaff()
        || (isListed() && myUnit() != '' && (resource == null || resource.data.unit == myUnit()));
      allow create: if (isSuper() || isPenjagaOf(request.resource.data.unit))
        && request.resource.data.unit is string
        && request.resource.data.items is map;
      // Baki awal yang telah dikunci hanya boleh dibuka semula oleh SuperAdmin atau Pegawai Pelulus
      // (pelulus: buka kunci sahaja; tidak boleh mengubah baki item)
      allow update: if request.resource.data.items is map
        && (isSuper()
            || (isPelulus()
                && request.resource.data.get('bakiAwalDikunci', true) == false
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['bakiAwalDikunci', 'bakiAwalDibukaPada', 'bakiAwalDibukaOleh']))
            || (isPenjagaOf(resource.data.unit)
                && request.resource.data.unit == resource.data.unit
                && (resource.data.get('bakiAwalDikunci', false) == false
                    || request.resource.data.get('bakiAwalDikunci', false) == true)));
      allow delete: if isSuper();
    }

    // Log pergerakan stok klinik (tambah sahaja): terima, keluar, baki awal, pelarasan
    match /kraipro_klinik_log/{logId} {
      allow read: if isStaff() || (resource != null && isPenjagaOf(resource.data.unit));
      allow create: if (isStaff() || isPenjagaOf(request.resource.data.unit))
        && request.resource.data.userEmail == myEmail()
        && request.resource.data.jenis in ['terima', 'keluar', 'baki_awal', 'pelarasan', 'pindah_keluar', 'pindah_masuk', 'pindah_batal']
        && request.resource.data.bulan is string
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 1000;
      allow update: if false;
      allow delete: if isSuper();
    }

    // Pindahan stok (KEW.PS-17 / BPIN): klinik ke klinik, atau pulangan klinik ke stor daerah ('Stor Daerah')
    match /kraipro_pindahan/{pinId} {
      allow read: if isStaff()
        || (isPenjaga() && (resource == null
            || isPenjagaOf(resource.data.dariUnit) || isPenjagaOf(resource.data.keUnit)));
      // Dicipta oleh penjaga stor klinik pemberi
      allow create: if isPenjagaOf(request.resource.data.dariUnit)
        && pinId.matches('BPIN-[0-9]{4}-[0-9]{3,6}')
        && request.resource.data.id == pinId
        && request.resource.data.status == 'Dihantar'
        && request.resource.data.pengirimEmail == myEmail()
        && request.resource.data.keUnit is string
        && request.resource.data.keUnit != request.resource.data.dariUnit
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100;
      allow update: if
        // Pelulus/SuperAdmin: sahkan terima pulangan ke stor daerah; SuperAdmin juga boleh batalkan
        isStaff()
        // Klinik penerima sahkan terima
        || (resource.data.status == 'Dihantar'
            && isPenjagaOf(resource.data.keUnit)
            && request.resource.data.status == 'Diterima'
            && request.resource.data.penerimaEmail == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'penerimaEmail', 'penerimaNama', 'terimaPada', 'terimaQty']))
        // Klinik pemberi batalkan sebelum diterima
        || (resource.data.status == 'Dihantar'
            && isPenjagaOf(resource.data.dariUnit)
            && request.resource.data.status == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'batalPada', 'dibatalkanOleh']));
      allow delete: if isSuper();
    }

    // Ringkasan stok dikeluarkan (diluluskan) kepada setiap unit/klinik bagi setahun: { unit, tahun, items: { itemId: kuantiti } }
    // Dijana semula oleh pelulus/SuperAdmin daripada permohonan; staf unit baca ringkasan unit sendiri sahaja.
    match /kraipro_unit_usage/{uid} {
      allow read: if isStaff()
        || (isListed() && myUnit() != '' && (resource == null || resource.data.unit == myUnit()));
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['unit', 'tahun', 'items', 'dikemaskiniPada'])
        && request.resource.data.unit is string
        && request.resource.data.tahun is string
        && request.resource.data.items is map;
      allow delete: if isStaff();
    }

    // Permohonan item baharu (item yang tiada dalam Stok Induk)
    function validNewItemText(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }
    match /kraipro_item_baharu/{nid} {
      allow read: if isStaff() || (isMember() && resource != null && resource.data.ownerEmail == myEmail());
      allow create: if isMember()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.status == 'Baru'
        && request.resource.data.keys().hasOnly(['ownerEmail', 'pemohonNama', 'unit', 'item', 'spesifikasi', 'kuantiti',
             'unitUkuran', 'justifikasi', 'status', 'tarikh', 'createdAt'])
        && validNewItemText('item', 150) && request.resource.data.item.size() > 0
        && validNewItemText('spesifikasi', 300)
        && validNewItemText('justifikasi', 500) && request.resource.data.justifikasi.size() > 0
        && validNewItemText('unitUkuran', 30)
        && request.resource.data.kuantiti is int && request.resource.data.kuantiti > 0;
      allow update: if isStaff()
        // Pemohon boleh membatalkan permohonan sendiri yang masih baharu
        || (isMember()
            && resource.data.ownerEmail == myEmail()
            && resource.data.status == 'Baru'
            && request.resource.data.status == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dikemaskiniPada']));
      allow delete: if isSuper();
    }

    // Pembilang nombor permohonan BPSI (satu dokumen setiap tahun, cth: bpsi_2026)
    match /kraipro_counters/{counterId} {
      allow read: if isMember();
      allow create: if request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq is int
        && (isSuper() || (isMember() && request.resource.data.seq == 1));
      allow update: if request.resource.data.keys().hasOnly(['seq'])
        && request.resource.data.seq is int
        && (isSuper() || (isMember() && request.resource.data.seq == resource.data.seq + 1));
      allow delete: if false;
    }

    // Log jejak audit (tambah sahaja; tidak boleh diubah)
    match /kraipro_audit/{logId} {
      allow read: if isStaff();
      allow create: if isSuper() || (isMember() && request.resource.data.userEmail == myEmail());
      allow update: if false;
      allow delete: if isSuper();
    }
  }
}
